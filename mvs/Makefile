all: cart bios

BUILDDIR=build
SRCDIRS=assets src
CFLAGS=-I$(BUILDDIR) -Isrc -std=c99 -O2 -fomit-frame-pointer
LDFLAGS=
Z80FLAGS=
Z80LDFLAGS=

include config.mk

GAMEROM=ghostngol
GAMETITLE=Ghosts n Goals

include rom.mk
include build.mk
include emu.mk

ELF=$(BUILDDIR)/rom.elf
CORE_OBJS=$(BUILDDIR)/src/game.o $(BUILDDIR)/src/levels.o $(BUILDDIR)/src/characters.o

# ngdevkit's generic %.o rule does not itself create nested output folders.
$(CORE_OBJS): | $(BUILDDIR)/src

$(ELF): $(BUILDDIR)/main.o $(CORE_OBJS)
$(PROM1): $(ELF)

# FIX text remains the stock ngdevkit font for BIOS/title/HUD text.
$(SROM1): $(BUILDDIR)/assets/base-srom-text-shadow.fix

# C-ROM layout is intentional and mirrored by src/gfx_assets.h generated by
# scripts/build-mvs-visual-assets.py. The stock BIOS/logo block occupies
# tiles 0..255; Ghosts'n Goals graphics start at tile 256.
$(CROM1): $(BUILDDIR)/assets/base-crom-logo.c1
$(CROM2): $(BUILDDIR)/assets/base-crom-logo.c2
$(CROM1): $(BUILDDIR)/assets/gng_l1_bg.c1
$(CROM2): $(BUILDDIR)/assets/gng_l1_bg.c2
$(CROM1): $(BUILDDIR)/assets/gng_shpendi.c1
$(CROM2): $(BUILDDIR)/assets/gng_shpendi.c2
$(CROM1): $(BUILDDIR)/assets/gng_zombie.c1
$(CROM2): $(BUILDDIR)/assets/gng_zombie.c2
$(CROM1): $(BUILDDIR)/assets/gng_ball.c1
$(CROM2): $(BUILDDIR)/assets/gng_ball.c2

# BIOS-compatible nullsound M-ROM. Real music/SFX comes after the visual slice.
SOUND_DRIVER=$(BUILDDIR)/assets/base-sound-driver.ihx
$(MROM1): $(SOUND_DRIVER)

CUSTOM_GENERATE_TARGETS=
